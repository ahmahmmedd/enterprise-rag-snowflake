# =============================================================================
# Snowflake connection settings for the Enterprise Financial RAG Assistant
#
# Copy this file to ".env" and fill in your real values.
# NEVER commit your actual ".env" file to version control.
#
# These variables are read by langchain_snowflake.create_session_from_env()
# to build an authenticated snowflake.snowpark.Session.
# =============================================================================

# --- Core connection -------------------------------------------------------
SNOWFLAKE_ACCOUNT=your_account_identifier        # e.g. xy12345.us-east-1
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password

# --- Role / Warehouse / Default DB-Schema ----------------------------------
SNOWFLAKE_ROLE=YOUR_ROLE                         # e.g. FINANCE_ANALYST_ROLE
SNOWFLAKE_WAREHOUSE=YOUR_WAREHOUSE                # e.g. FINANCE_WH
SNOWFLAKE_DATABASE=FINANCE_DB
SNOWFLAKE_SCHEMA=DATA

# --- Optional: alternate authentication ------------------------------------
# If you use key-pair auth, SSO, or MFA instead of username/password,
# set SNOWFLAKE_AUTHENTICATOR accordingly (e.g. "externalbrowser",
# "snowflake_jwt") and consult the langchain-snowflake documentation for the
# additional variables required (e.g. SNOWFLAKE_PRIVATE_KEY_PATH).
# SNOWFLAKE_AUTHENTICATOR=externalbrowser

# --- Optional: override the Cortex chat model at runtime --------------------
CORTEX_CHAT_MODEL=claude-3-5-sonnet
